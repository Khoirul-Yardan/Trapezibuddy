{
  "name": "trapezibuddy",
  "version": "1.0.0",
  "description": "Desktop companion interaktif untuk produktivitas",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:companion": "electron . --dev --page=companion",
    "dev:add-task": "electron . --dev --page=add-task",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "electron-builder"
  },
  "keywords": [
    "desktop",
    "companion",
    "productivity"
  ],
  "author": "TrapeziBuddy Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.trapezibuddy.app",
    "productName": "TrapeziBuddy",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      "assets/**/*",
      "build/icons/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/gugugaga.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TrapeziBuddy"
    },
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
