{
  "name": "trapezibuddy",
  "version": "0.1.0",
  "description": "Desktop companion interaktif untuk produktivitas",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:chat": "electron . --dev --page=chat",
    "dev:companion": "electron . --dev --page=companion",
    "dev:add-task": "electron . --dev --page=add-task",
    "dev:confirm-task": "electron . --dev --page=confirm-task",
    "build": "electron-builder"
  },
  "keywords": [
    "desktop",
    "companion",
    "productivity"
  ],
  "author": "TrapeziBuddy Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.trapezibuddy.app",
    "productName": "TrapeziBuddy",
    "win": {
      "target": "nsis",
      "icon": "build/icons/gugugaga.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TrapeziBuddy"
    },
    "extraResources": [
      {
        "from": "../dist/main",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
