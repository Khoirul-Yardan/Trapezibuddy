{
  "name": "trapezibuddy",
  "version": "0.1.0",
  "description": "Desktop companion interaktif untuk produktivitas",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": ["desktop", "companion", "productivity"],
  "author": "TrapeziBuddy Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
